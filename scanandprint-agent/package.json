{
  "name": "scan-and-print-agent",
  "version": "1.0.3",
  "description": "Production Desktop Print Agent for Scan&Print (SP ScanAndPrint) automated printing network",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "prebuild:win": "powershell -Command \"Get-Process | Where-Object { $_.ProcessName -like '*Scan&Print*' -or $_.ProcessName -like '*electron*' } | Stop-Process -Force -ErrorAction SilentlyContinue; exit 0\"",
    "build:win": "electron-builder --win nsis",
    "test:print": "node src/test-print.js"
  },
  "keywords": [
    "print-agent",
    "silent-print",
    "scanandprint",
    "electron"
  ],
  "author": "Scan&Print Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "electron-store": "^8.2.0",
    "node-machine-id": "^1.1.12",
    "pdf-lib": "^1.17.1",
    "pdf-to-printer": "^5.6.0",
    "socket.io-client": "^4.8.1",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.scanandprint.agent",
    "productName": "Scan&Print Agent",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Scan&Print Agent",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  }
}
